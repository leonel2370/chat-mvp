# Mot de passe du tableau de bord d'administration (/admin). Obligatoire en production.
ADMIN_PASSWORD=change-me
# Origine(s) autorisée(s) pour la CORS, séparées par des virgules
# (ex. https://chat-client.onrender.com). Obligatoire en production.
CLIENT_ORIGIN=
# Port d'écoute (fourni automatiquement par l'hébergeur en production).
PORT=5000
# Serveur TURN (optionnel) : identifiants éphémères générés par le serveur.
# Secret partagé avec le serveur TURN (coturn : static-auth-secret).
TURN_SECRET=
# URL(s) du serveur TURN, séparées par des virgules (ex. turn:turn.monsite.com:3478).
TURN_URLS=
# Niveau de journalisation : error | warn | info | debug (défaut : info).
LOG_LEVEL=info
