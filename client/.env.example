# URL du serveur de signalisation Socket.io.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# URL publique du site (SEO et partage social).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Zones publicitaires ExoClick (optionnelles ; vides = publicités désactivées).
NEXT_PUBLIC_EXOCLICK_ZONE_TERMS=
NEXT_PUBLIC_EXOCLICK_ZONE_LOBBY=
NEXT_PUBLIC_EXOCLICK_ZONE_INTERSTITIAL=
NEXT_PUBLIC_EXOCLICK_ZONE_FOOTER=
# Adresse de contact affichée dans les pages légales (confidentialité / conditions).
NEXT_PUBLIC_CONTACT_EMAIL=contact@your-domain.com
